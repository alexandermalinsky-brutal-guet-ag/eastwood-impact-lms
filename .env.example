# Postgres — provisioned via the Vercel dashboard (Storage → Create Database → Postgres).
# Vercel injects these automatically once the store is linked to the project.
DATABASE_URL="postgres://user:password@host/db?sslmode=require"

# Auth.js — generate with: npx auth secret
AUTH_SECRET="replace-me"

# Optional: Google Workspace sign-in for @eastwoodmontreux.ch accounts.
# Leave unset to use email + password sign-in only.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Email domain allowed to self-register with Google sign-in.
ALLOWED_EMAIL_DOMAIN="eastwoodmontreux.ch"
